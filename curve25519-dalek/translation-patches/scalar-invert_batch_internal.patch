Translation patch: Scalar::invert_batch_internal (src/scalar.rs)

Change: Both passes of the batch inversion: `for (input, scratch) in inputs.iter_mut().zip(scratch.iter_mut())` and
`... inputs.iter_mut().rev().zip(scratch.iter().rev())` become index `while` loops.

Why: Aeneas fails on borrows threaded through iterator adaptors over slices
(`iter`/`iter_mut` combined with `zip`/`rev`/`map`/`collect`/`fold` closures):
"Internal error" in InterpBorrowsCore.ml.

Behaviour: identical. Each iterator pass becomes a `while` loop over an index
`0..n` (forwards) or `n..0` (backwards, via `k -= 1` at the top of the loop)
visiting the same elements in the same order and performing the same
operations on them; `inputs[i]` / `scratch[i]` replace the zipped references.
The indexing cannot panic and `zip` never truncates: the index stays below
`n = inputs.len()` and the zipped slices always have length `n`. They are either
built with length `n` in this function, or (for `internal_invert_batch` /
`invert_batch_internal`, private functions) every caller passes a `scratch` of the
same length as `inputs`, which is also `debug_assert`ed.

Remove this patch when Aeneas translates the original code: delete the file,
run ./scripts/aeneas-translate.sh, and check it succeeds.

diff --git a/curve25519-dalek/src/scalar.rs b/curve25519-dalek/src/scalar.rs
index 7fc7f3c..eddffb4 100644
--- a/curve25519-dalek/src/scalar.rs
+++ b/curve25519-dalek/src/scalar.rs
@@ -811,47 +811,52 @@ pub fn invert_batch_alloc(inputs: &mut [Scalar]) -> Scalar {
     fn invert_batch_internal(inputs: &mut [Scalar], scratch: &mut [UnpackedScalar]) -> Scalar {
         // This code is essentially identical to the FieldElement
         // implementation, and is documented there.  Unfortunately,
         // it's not easy to write it generically, since here we want
         // to use `UnpackedScalar`s internally, and `Scalar`s
         // externally, but there's no corresponding distinction for
         // field elements.
 
         // Keep an accumulator of all of the previous products
         let mut acc = Scalar::ONE.unpack().as_montgomery();
 
         // Pass through the input vector, recording the previous
         // products in the scratch space
-        for (input, scratch) in inputs.iter_mut().zip(scratch.iter_mut()) {
-            *scratch = acc;
+        let n = inputs.len();
+        let mut i = 0;
+        while i < n {
+            scratch[i] = acc;
 
             // Avoid unnecessary Montgomery multiplication in second pass by
             // keeping inputs in Montgomery form
-            let tmp = input.unpack().as_montgomery();
-            *input = tmp.pack();
+            let tmp = inputs[i].unpack().as_montgomery();
+            inputs[i] = tmp.pack();
             acc = UnpackedScalar::montgomery_mul(&acc, &tmp);
+            i += 1;
         }
 
         // acc is nonzero iff all inputs are nonzero
         debug_assert!(acc.pack() != Scalar::ZERO);
 
         // Compute the inverse of all products
         acc = acc.montgomery_invert().from_montgomery();
 
         // We need to return the product of all inverses later
         let ret = acc.pack();
 
         // Pass through the vector backwards to compute the inverses
         // in place
-        for (input, scratch) in inputs.iter_mut().rev().zip(scratch.iter().rev()) {
-            let tmp = UnpackedScalar::montgomery_mul(&acc, &input.unpack());
-            *input = UnpackedScalar::montgomery_mul(&acc, scratch).pack();
+        let mut k = n;
+        while k > 0 {
+            k -= 1;
+            let tmp = UnpackedScalar::montgomery_mul(&acc, &inputs[k].unpack());
+            inputs[k] = UnpackedScalar::montgomery_mul(&acc, &scratch[k]).pack();
             acc = tmp;
         }
 
         #[cfg(feature = "zeroize")]
         Zeroize::zeroize(&mut scratch.iter_mut());
 
         ret
     }
 
     /// Compute `b` such that `b + b = a mod modulus`.
